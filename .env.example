# Required for live AI drafting. Without it the page still works: people write the text themselves.
ANTHROPIC_API_KEY=
# Optional
ANTHROPIC_MODEL=claude-haiku-5-5
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_DAY=300
# Optional shared rate limiting across instances (without these, limits are per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local testing only: canned answers, no API calls
MOCK_AI=
